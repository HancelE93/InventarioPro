generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Producto {
  id         Int      @id @default(autoincrement())
  nombre     String
  precio     Float
  categoria  String
  fotoBase64 String?
  codigoBarras String?
  createdAt  DateTime @default(now())
}